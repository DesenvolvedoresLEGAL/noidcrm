# NOID RevenueOS — Environment variables template (sanitized).
# Copy this file to `.env` locally and fill with values from Lovable Cloud / Supabase.
# NEVER commit `.env`. Only publishable/anon keys should ever appear in a client
# bundle; service_role keys and private secrets belong in Edge Function secrets.

# --- Supabase (Lovable Cloud) — publishable values, safe in browser bundle ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...replace-me...
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Legacy aliases still referenced by a few utility scripts — same values as above.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...replace-me...

# --- Firebase (optional / legacy web push) — publishable client keys ---
VITE_FB_API_KEY=replace-me
VITE_FB_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FB_PROJECT_ID=your-firebase-project
VITE_FB_APP_ID=1:000000000000:web:replace-me

# --- Feature flags ---
VITE_MOCK_AUTH=false
